# Public app config
NEXT_PUBLIC_APP_URL=https://booking-system-self-five.vercel.app
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=PASTE_SUPABASE_ANON_KEY_HERE

# Server-only Supabase
SUPABASE_SERVICE_ROLE_KEY=PASTE_SUPABASE_SERVICE_ROLE_KEY_HERE

# Server-only cron route secret. Do not prefix with NEXT_PUBLIC_.
CRON_SECRET=PASTE_LONG_RANDOM_CRON_SECRET_HERE

# App identity
APP_TIMEZONE=Asia/Kuala_Lumpur
APP_NAME=Booking System
COMPANY_NAME=YOUR_COMPANY_NAME
SYSTEM_CONTACT_EMAIL=YOUR_CONTACT_EMAIL

# Email provider
EMAIL_PROVIDER=microsoft_graph
EMAIL_FROM=Booking System <noreply@yourcompany.com>
EMAIL_API_KEY=

# Microsoft Graph email. The sender must be the mailbox to which the Entra app
# is restricted. EMAIL_FROM should identify that same mailbox.
EMAIL_MICROSOFT_TENANT_ID=PASTE_TENANT_ID_HERE
EMAIL_MICROSOFT_CLIENT_ID=PASTE_EMAIL_APP_CLIENT_ID_HERE
EMAIL_MICROSOFT_CLIENT_SECRET=PASTE_EMAIL_APP_CLIENT_SECRET_HERE
EMAIL_MICROSOFT_SENDER=noreply@yourcompany.com

# Optional generic SMTP fallback for a non-Microsoft provider.
SMTP_HOST=
SMTP_PORT=
SMTP_SECURE=
SMTP_REQUIRE_TLS=
SMTP_USER=
SMTP_PASSWORD=

# Microsoft 365 Calendar sync disabled until IT setup is ready
CALENDAR_SYNC_PROVIDER=disabled
MICROSOFT_365_CALENDAR_SYNC_ENABLED=false
# Use central_calendar for MICROSOFT_DEFAULT_CALENDAR_ID, or
# booking_owner_calendar for each booking owner's company mailbox.
MICROSOFT_SYNC_MODE=disabled
MICROSOFT_TENANT_ID=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_DEFAULT_CALENDAR_ID=
MICROSOFT_GRAPH_AUTH_MODE=app_only
MICROSOFT_DELEGATED_TOKEN_ENCRYPTION_KEY=
MICROSOFT_GRAPH_BASE_URL=https://graph.microsoft.com/v1.0

# n8n webhook calendar sync. Configure create only for testing, or all three
# webhook URLs for full lifecycle create/update/delete sync.
N8N_CALENDAR_SYNC_ENABLED=false
N8N_CALENDAR_CREATE_WEBHOOK_URL=
N8N_CALENDAR_UPDATE_WEBHOOK_URL=
N8N_CALENDAR_DELETE_WEBHOOK_URL=
N8N_CALENDAR_WEBHOOK_SECRET=
